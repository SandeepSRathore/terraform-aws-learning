# Provider plugins downloaded by `terraform init` (large, re-downloadable)
**/.terraform/*

# State files: Terraform's record of what it created. Can contain secrets.
*.tfstate
*.tfstate.*

# Crash logs
crash.log
crash.*.log

# Variable files often hold environment-specific or secret values
*.tfvars
*.tfvars.json

# SSH private keys generated by lessons
*.pem

# Lambda zips built by archive_file (rebuilt on every plan)
**/.build/

# Saved plan files
*.tfplan

# Note: DO commit .terraform.lock.hcl. It pins exact provider versions.
