#!/bin/bash
# Runs as root on first boot. Log: /var/log/cloud-init-output.log
set -euxo pipefail

dnf install -y nginx

cat > /usr/share/nginx/html/index.html <<'EOF'
<!doctype html>
<html>
  <head><title>Terraform dev</title></head>
  <body style="font-family: sans-serif; margin: 3rem;">
    <h1>${message}</h1>
    <p>Served by nginx on EC2, built from Terraform modules.</p>
  </body>
</html>
EOF

systemctl enable --now nginx
