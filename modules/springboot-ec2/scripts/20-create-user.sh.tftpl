# ---- 20: a dedicated, unprivileged user to run the app ----
# If the app is ever compromised, the attacker gets this user, not root.
step "Create user $APP_USER and folders"

id -u "$APP_USER" >/dev/null 2>&1 \
  || useradd --system --no-create-home --shell /sbin/nologin "$APP_USER"

install -d -o "$APP_USER" -g "$APP_USER" -m 0750 "$APP_DIR"
install -d -o root -g "$APP_USER" -m 0750 "$CONF_DIR"
