# Point the AWS CLI AND Terraform at LocalStack for this shell:
#   source reference/localstack.env
# After that, every `aws ...` command in the exercise scripts is exactly what
# you'd type against real AWS. Open a new shell (or unset these) to go back.

export AWS_ACCESS_KEY_ID=test
export AWS_SECRET_ACCESS_KEY=test
export AWS_DEFAULT_REGION=us-east-1
export AWS_ENDPOINT_URL=http://localhost:4566 # the AWS CLI v2 honours this for every service
export AWS_PAGER=""                           # print output directly, no `less`
export TF_VAR_use_localstack=true             # Terraform: same as -var use_localstack=true
