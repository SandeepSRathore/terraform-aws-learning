# Copy to terraform.tfvars and edit. Terraform loads terraform.tfvars automatically.
#   cp terraform.tfvars.example terraform.tfvars

aws_region    = "us-east-1"
name          = "tf-learning-web"
instance_type = "t3.micro"
web_message   = "Hello from Terraform!"

enable_extra_volume = false
enable_elastic_ip   = false
